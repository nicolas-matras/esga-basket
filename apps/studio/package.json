{
  "name": "@esga/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "sanity dev --port 3333",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "extract": "sanity schema extract --path ./schema.json --force",
    "typegen": "pnpm run extract && sanity typegen generate",
    "manage": "sanity manage",
    "verifier": "tsc --noEmit && sanity build --no-minify"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.2",
    "@sanity/ui": "^4.2.1",
    "@sanity/vision": "^6.14.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "sanity": "^6.14.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
