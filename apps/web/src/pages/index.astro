---
import CarteActu from '../components/CarteActu.astro';
import CarteMatch from '../components/CarteMatch.astro';
import TableauClassement from '../components/TableauClassement.astro';
import Base from '../layouts/Base.astro';
import {
  REQ_ACCUEIL,
  REQ_ACTUALITES,
  REQ_MATCHS_A_VENIR,
  REQ_REGROUPEMENTS,
} from '../lib/requetes';
import { interroger, urlImage, type SourceImage } from '../lib/sanity';
import { compteARebours, dateCourte, heure } from '../lib/format';
import type { Actualite, Categorie, LigneClassement, Match } from '../lib/types';

type Accueil = {
  surtitre?: string;
  titre?: string;
  motAccentue?: string;
  intro?: string;
  ctaPrincipal?: { libelle?: string; url?: string };
  ctaVideo?: { libelle?: string; url?: string };
  photo?: SourceImage;
  chiffres?: { _key: string; valeur?: string; libelle?: string }[];
  badgeProchainMatch?: string;
  classement?: {
    nom?: string;
    championnat?: string;
    releve?: { misAJourLe?: string; syncSource?: string; lignes?: LigneClassement[] };
  };
  blocBenevole?: { surtitre?: string; titre?: string; texte?: string; libelleBouton?: string };
  blocInscription?: {
    titre?: string;
    texte?: string;
    libelleBouton?: string;
    etapes?: { _key: string; titre?: string; texte?: string }[];
  };
  seo?: { titre?: string; description?: string };
};

const page = await interroger<Accueil>(REQ_ACCUEIL);
const matchs = await interroger<Match[]>(REQ_MATCHS_A_VENIR);
const regroupements = await interroger<Categorie[]>(REQ_REGROUPEMENTS);
const actualites = await interroger<Actualite[]>(REQ_ACTUALITES);

/**
 * La maquette met le dernier mot du titre en orange
 * (« On joue tous pour le même <orange>maillot</orange> »).
 * Le mot est éditable dans le Studio : on le découpe ici plutôt que de figer
 * le markup. S'il n'est pas trouvé dans le titre, on affiche le titre tel quel.
 */
function decouperTitre(titre?: string, accent?: string) {
  if (!titre) return null;
  if (!accent) return { avant: titre, mot: '', apres: '' };
  const i = titre.toLowerCase().lastIndexOf(accent.toLowerCase());
  if (i === -1) return { avant: titre, mot: '', apres: '' };
  return {
    avant: titre.slice(0, i),
    mot: titre.slice(i, i + accent.length),
    apres: titre.slice(i + accent.length),
  };
}

const titreDecoupe = decouperTitre(page?.titre, page?.motAccentue);

/*
  La rencontre mise en avant dans le héros.

  On ne prend pas bêtement la prochaine du calendrier : avec 28 équipes, ce
  serait le plus souvent un plateau U9 le dimanche matin. La SM1 est l'équipe
  vitrine du club, la SF1 vient juste après. On retombe sur la prochaine venue
  seulement si aucune des deux ne joue.
*/
const PRIORITE = ['SM1', 'SF1'];
const phare =
  PRIORITE.map((nom) => matchs.find((m) => m.equipe?.nom === nom)).find(Boolean) ?? matchs[0];
const prochain = phare;
const suivants = matchs.filter((m) => m._id !== phare?._id).slice(0, 3);
const photoHeros = urlImage(page?.photo, 900, 1200);
const lignes = page?.classement?.releve?.lignes ?? [];
---

<Base
  titre={page?.seo?.titre ?? 'Accueil'}
  description={page?.seo?.description ?? page?.intro}
  page="accueil"
>
  <!-- ---------- Héros ---------- -->
  <section class="heros">
    <span class="heros__halo" aria-hidden="true"></span>
    <span class="heros__trame" aria-hidden="true"></span>

    <div class="heros__grille">
      <div>
        {page?.surtitre && <p class="heros__pastille">{page.surtitre}</p>}
        {
          titreDecoupe && (
            <h1 class="heros__titre">
              {titreDecoupe.avant}
              {titreDecoupe.mot && <span class="heros__accent">{titreDecoupe.mot}</span>}
              {titreDecoupe.apres}
            </h1>
          )
        }
        {page?.intro && <p class="heros__chapo">{page.intro}</p>}

        <div class="heros__actions">
          {
            page?.ctaPrincipal?.libelle && (
              <a
                href={page.ctaPrincipal.url ?? '/inscriptions'}
                class="bouton bouton--navy bouton--large"
              >
                {page.ctaPrincipal.libelle} →
              </a>
            )
          }
          {
            page?.ctaVideo?.libelle && (
              <a
                href={page.ctaVideo.url ?? '#'}
                class="bouton bouton--secondaire bouton--large"
                aria-disabled={page.ctaVideo.url ? undefined : 'true'}
              >
                ▶ {page.ctaVideo.libelle}
              </a>
            )
          }
        </div>

        {
          page?.chiffres && page.chiffres.length > 0 && (
            <ul class="chiffres-cles">
              {page.chiffres.map((c) => (
                <li>
                  <span class="chiffres-cles__valeur chiffres">{c.valeur}</span>
                  <span class="chiffres-cles__libelle">{c.libelle}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="heros__visuel">
        <div class="heros__media">
          {
            photoHeros ? (
              <img src={photoHeros} alt={page?.photo?.alt ?? ''} width="900" height="1200" />
            ) : (
              <span class="heros__attente mention">
                photo à fournir — équipe au Gonzales, portrait 900×1200
              </span>
            )
          }
        </div>

        {
          page?.badgeProchainMatch && (
            <span class="heros__pastille-offre">{page.badgeProchainMatch}</span>
          )
        }

        {
          phare && (
            <aside class="heros__match">
              <header class="heros__match-entete">
                <span class="surtitre">Prochain match</span>
                {compteARebours(phare.debut) && (
                  <span class="heros__match-rebours">{compteARebours(phare.debut)}</span>
                )}
              </header>
              <div class="heros__match-affiche">
                {
                  (phare.domicile
                    ? ['/logo-esga.png', phare.logoAdversaireUrl]
                    : [phare.logoAdversaireUrl, '/logo-esga.png']
                  ).map((src, i) => (
                    <>
                      {i === 1 && <span class="heros__match-vs">VS</span>}
                      {src ? (
                        <img
                          src={src}
                          alt=""
                          width="44"
                          height="44"
                          onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'heros__match-logo'}))"
                        />
                      ) : (
                        <span class="heros__match-logo" aria-hidden="true"></span>
                      )}
                    </>
                  ))
                }
              </div>
              <p class="heros__match-equipes">
                <strong>{phare.equipe?.nom}</strong> {phare.domicile ? 'reçoit' : 'se déplace à'}{' '}
                {phare.adversaire}
              </p>
              <p class="heros__match-quand">
                {dateCourte(phare.debut)} · {heure(phare.debut)} ·{' '}
                {
                  phare.domicile
                    ? 'Domicile'
                    : phare.salle && !/^\d+$/.test(phare.salle)
                      ? phare.salle
                      : 'Extérieur'
                }
              </p>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  <!-- ---------- Prochain match ---------- -->
  {
    prochain && (
      <section class="section">
        <div class="contenu">
          <div class="entete-section">
            <h2 class="titre-2">Nuit de match</h2>
            <a href="/agenda" class="lien-fleche">Agenda complet ↗</a>
          </div>

          <div class="grille-match">
            <div>
              <CarteMatch match={prochain} vedette />
              {page?.badgeProchainMatch && (
                <p class="badge-offert">{page.badgeProchainMatch}</p>
              )}
            </div>
            <div class="grille-match__liste">
              {suivants.map((m) => (
                <CarteMatch match={m} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ---------- Classement ---------- -->
  {
    lignes.length > 0 && (
      <section class="section section--douce">
        <div class="contenu">
          <div class="entete-section">
            <h2 class="titre-2">Classement {page?.classement?.nom} · {page?.classement?.championnat}</h2>
            <a href="/resultats" class="lien-fleche">Tous les classements ↗</a>
          </div>
          <TableauClassement
            lignes={lignes}
            misAJourLe={page?.classement?.releve?.misAJourLe}
            source={page?.classement?.releve?.syncSource}
            compact
          />
        </div>
      </section>
    )
  }

  <!-- ---------- Trouve ton équipe ---------- -->
  {
    regroupements.length > 0 && (
      <section class="section">
        <div class="contenu">
          <div class="entete-section">
            <h2 class="titre-2">Trouve ton équipe</h2>
            <a href="/equipes" class="lien-fleche">Les équipes ↗</a>
          </div>
          <div class="grille grille--auto">
            {regroupements.map((r) => (
              <a href="/equipes" class="carte categorie">
                <span class="categorie__libelle">{r.regroupement}</span>
                <span class="titre-3">{r.accroche}</span>
                <span class="categorie__detail">{r.detail}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ---------- Actualités ---------- -->
  {
    actualites.length > 0 && (
      <section class="section">
        <div class="contenu">
          <div class="entete-section">
            <h2 class="titre-2">La vie du club</h2>
            <a href="/actualites" class="lien-fleche">Toutes les actus ↗</a>
          </div>
          <div class="grille grille--large">
            {actualites.slice(0, 2).map((a) => (
              <CarteActu actualite={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ---------- Bénévolat + inscription ---------- -->
  <section class="section">
    <div class="contenu grille grille--large">
      {
        page?.blocBenevole?.titre && (
          <div class="carte bloc bloc--encre">
            <p class="surtitre">{page.blocBenevole.surtitre}</p>
            <h2 class="titre-2">{page.blocBenevole.titre}</h2>
            <p class="chapo">{page.blocBenevole.texte}</p>
            <a href="/contact" class="bouton bouton--principal">
              {page.blocBenevole.libelleBouton} →
            </a>
          </div>
        )
      }
      {
        page?.blocInscription?.titre && (
          <div class="carte bloc">
            <h2 class="titre-2">{page.blocInscription.titre}</h2>
            <p class="chapo">{page.blocInscription.texte}</p>
            <ol class="etapes">
              {(page.blocInscription.etapes ?? []).map((e, i) => (
                <li>
                  <span class="etapes__numero chiffres">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <strong>{e.titre}</strong>
                    <span class="etapes__texte">{e.texte}</span>
                  </span>
                </li>
              ))}
            </ol>
            <a href="/inscriptions" class="bouton bouton--principal">
              {page.blocInscription.libelleBouton} →
            </a>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  /*
    Le héros de la maquette : fond gris très clair, halo bleu en haut à gauche,
    trame verticale de 72 px, et une cascade d'apparitions.
  */
  .heros {
    position: relative;
    overflow: hidden;
    background: var(--c-fond-doux);
    border-bottom: 1px solid var(--c-bordure-douce);
  }
  .heros__halo {
    position: absolute;
    top: -150px;
    left: -110px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(30 66 168 / 0.14), transparent 70%);
    animation: halo 7s ease-in-out infinite;
    pointer-events: none;
  }
  .heros__trame {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      90deg,
      rgb(12 27 74 / 0.04) 0 1px,
      transparent 1px 72px
    );
    pointer-events: none;
  }
  @keyframes halo {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.9;
    }
  }
  @keyframes monter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .heros__grille {
    position: relative;
    max-width: 1180px;
    margin-inline: auto;
    padding: clamp(34px, 5vw, 60px) var(--e-gouttiere) clamp(38px, 5vw, 54px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
  }

  .heros__pastille {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--c-surface);
    border: 1px solid var(--c-bordure);
    border-radius: var(--r-pilule);
    padding: 7px 14px;
    font: 700 var(--t-etiquette) / 1 var(--f-mono);
    letter-spacing: var(--ls-etiquette-large);
    text-transform: uppercase;
    color: var(--c-titre);
    margin: 0;
    animation: monter 0.9s ease both;
  }
  .heros__titre {
    font: 400 var(--t-d1) / var(--t-d1-lh) var(--f-titre);
    letter-spacing: var(--ls-titre);
    text-transform: uppercase;
    color: var(--c-titre);
    margin: 20px 0 0;
    text-wrap: balance;
    animation: monter 0.9s 0.06s ease both;
  }
  /* Le mot que le club met en avant, dans le bleu du club. */
  .heros__accent {
    color: var(--c-titre-accent);
  }
  .heros__chapo {
    font: 400 var(--t-chapo) / var(--t-chapo-lh) var(--f-texte);
    color: var(--c-texte);
    max-width: 450px;
    margin: 22px 0 0;
    text-wrap: pretty;
    animation: monter 0.9s 0.14s ease both;
  }
  .heros__actions {
    display: flex;
    gap: var(--e-4);
    flex-wrap: wrap;
    margin-top: 28px;
    animation: monter 0.9s 0.2s ease both;
  }
  /* La photo et ce qui se pose dessus : pastille d'offre et carte du match. */
  .heros__visuel {
    position: relative;
    animation: monter 0.9s 0.26s ease both;
  }
  .heros__pastille-offre {
    position: absolute;
    top: -14px;
    right: -10px;
    z-index: 2;
    width: 116px;
    height: 116px;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    background: var(--c-sport);
    color: #fff;
    padding: 10px;
    font: 700 var(--t-etiquette) / 1.35 var(--f-mono);
    letter-spacing: var(--ls-etiquette);
    text-transform: uppercase;
    box-shadow: 0 10px 28px rgb(242 106 36 / 0.36);
  }
  .heros__match {
    position: absolute;
    left: -18px;
    bottom: -26px;
    z-index: 2;
    width: min(320px, 84%);
    background: var(--c-fond-encre);
    color: #fff;
    border-radius: var(--r-xl);
    padding: var(--e-7);
    box-shadow: var(--o-carte-survol);
  }
  .heros__match-entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
  }
  .heros__match .surtitre {
    color: #fff;
  }
  .heros__match-rebours {
    font: 700 var(--t-etiquette) / 1 var(--f-mono);
    letter-spacing: var(--ls-etiquette);
    text-transform: uppercase;
    color: var(--c-sport);
  }
  .heros__match-affiche {
    display: flex;
    align-items: center;
    gap: var(--e-5);
    margin: var(--e-6) 0;
  }
  .heros__match-affiche img,
  .heros__match-logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: contain;
    flex: none;
    background: #fff;
  }
  .heros__match-logo {
    background: rgb(255 255 255 / 0.1);
    border: 1px dashed rgb(255 255 255 / 0.28);
  }
  .heros__match-vs {
    font: 400 var(--t-n7) / 1 var(--f-titre);
    color: var(--c-sport);
  }
  .heros__match-equipes {
    margin: 0;
    font: 500 var(--t-xs) / 1.5 var(--f-texte);
    color: #fff;
  }
  .heros__match-quand {
    margin: 6px 0 0;
    font: 400 var(--t-mono-corps) / 1.5 var(--f-mono);
    text-transform: uppercase;
    color: var(--brut-gris-08);
  }

  .heros__media {
    aspect-ratio: 3 / 4;
    border-radius: var(--r-2xl);
    background: var(--c-surface);
    border: 1px solid var(--c-bordure);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: var(--o-carte);
  }
  .heros__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .heros__attente {
    text-align: center;
    padding: var(--e-8);
  }

  .chiffres-cles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--e-6);
    margin: var(--e-11) 0 0;
    padding: var(--e-8) 0 0;
    border-top: 1px solid var(--c-bordure);
    animation: monter 0.9s 0.3s ease both;
  }
  /* Anton 40 px, navy — et non l'orange que j'avais mis. */
  .chiffres-cles__valeur {
    display: block;
    font: 400 var(--t-n1) / 1 var(--f-titre);
    color: var(--c-titre);
    text-transform: uppercase;
  }
  .chiffres-cles__libelle {
    display: block;
    margin-top: 6px;
    font: 700 var(--t-etiquette) / 1.4 var(--f-mono);
    letter-spacing: var(--ls-etiquette);
    text-transform: uppercase;
    color: var(--c-texte-2);
  }

  .lien-fleche {
    font: 700 var(--t-etiquette) / 1 var(--f-mono);
    letter-spacing: var(--ls-etiquette);
    text-transform: uppercase;
    color: var(--c-accent-texte);
    text-decoration: none;
    white-space: nowrap;
  }
  .lien-fleche:hover {
    color: var(--c-titre);
  }

  .grille-match {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--e-6);
    align-items: start;
  }
  .grille-match__liste {
    display: grid;
    gap: var(--e-5);
  }
  .badge-offert {
    margin: var(--e-5) 0 0;
    text-align: center;
    font: 700 var(--t-etiquette) / 1 var(--f-mono);
    letter-spacing: var(--ls-etiquette);
    text-transform: uppercase;
    color: var(--c-accent-texte);
  }

  .categorie {
    display: grid;
    gap: var(--e-3);
    padding: var(--e-8);
    text-decoration: none;
  }
  .categorie__libelle {
    font: 400 var(--t-n3) / 1 var(--f-titre);
    color: var(--c-accent);
    text-transform: uppercase;
  }
  .categorie__detail {
    font: 500 var(--t-xs) / 1.5 var(--f-texte);
    color: var(--c-texte-2);
  }

  .bloc {
    padding: var(--e-11);
    display: grid;
    gap: var(--e-6);
    align-content: start;
  }
  .bloc .bouton {
    justify-self: start;
  }
  .bloc--encre {
    background: var(--c-fond-encre);
    border-color: transparent;
    color: #fff;
  }
  .bloc--encre .titre-2 {
    color: #fff;
  }
  .bloc--encre .chapo {
    color: var(--brut-gris-05);
  }
  .bloc--encre .surtitre {
    color: var(--brut-orange);
  }

  .etapes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-5);
  }
  .etapes li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--e-5);
    align-items: baseline;
  }
  .etapes__numero {
    font: 400 var(--t-n6) / 1 var(--f-titre);
    color: var(--c-accent);
  }
  .etapes li strong {
    display: block;
    font: 700 var(--t-sm) / 1.4 var(--f-texte);
    color: var(--c-titre);
  }
  .etapes__texte {
    font: 400 var(--t-xs) / 1.6 var(--f-texte);
    color: var(--c-texte-2);
  }

  @media (max-width: 860px) {
    .grille-match {
      grid-template-columns: 1fr;
    }
    .heros__media {
      aspect-ratio: 4 / 3;
    }
    .heros__visuel {
      order: -1;
      margin-bottom: 42px;
    }
    .heros__match {
      left: 0;
      right: 0;
      width: auto;
    }
    .heros__pastille-offre {
      width: 94px;
      height: 94px;
      right: 0;
    }
  }
</style>
