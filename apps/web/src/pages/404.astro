---
import Base from '../layouts/Base.astro';
---

<Base titre="Page introuvable">
  <section class="section" style="padding-block:var(--e-section-large)">
    <div class="contenu" style="text-align:center">
      <p class="surtitre">Erreur 404</p>
      <h1 class="titre-1" style="margin-top:var(--e-5)">Ballon perdu</h1>
      <p class="chapo" style="margin-inline:auto">
        Cette page n'existe pas ou a été déplacée.
      </p>
      <a href="/" class="bouton bouton--principal" style="margin-top:var(--e-9)">Retour à l'accueil</a>
    </div>
  </section>
</Base>
