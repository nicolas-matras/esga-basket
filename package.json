{
  "name": "esga-basket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @esga/web dev",
    "dev:studio": "pnpm --filter @esga/studio dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @esga/web build",
    "build:studio": "pnpm --filter @esga/studio build",
    "preview": "pnpm --filter @esga/web preview",
    "typegen": "pnpm --filter @esga/studio typegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm --filter @esga/web check && pnpm --filter @esga/studio verifier && pnpm lint && pnpm format:check",
    "setup:env": "node tools/setup-env.mjs",
    "seed": "node tools/seed/index.mjs",
    "seed:photos": "node tools/seed/photos.mjs",
    "ffbb:sync": "node tools/ffbb/index.ts",
    "ffbb:dry": "node tools/ffbb/index.ts --dry-run",
    "test": "node --test tools/ffbb/*.test.ts",
    "ffbb:migration": "node tools/ffbb/migration.ts --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
