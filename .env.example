# =============================================================================
# ESGA Basket — variables d'environnement (référence complète)
#
# Ce fichier est un MODÈLE versionné. Il ne contient aucune valeur secrète.
# Pour travailler en local : pnpm setup:env  (copie ce modèle dans chaque app)
# En production : saisir ces variables dans l'interface de l'hébergeur.
# =============================================================================

# -----------------------------------------------------------------------------
# Sanity — identifiants du projet de contenu
# À récupérer sur https://sanity.io/manage après création du projet.
# Ce ne sont pas des secrets : ils figurent dans le site publié.
# -----------------------------------------------------------------------------
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2025-02-19"

# Mêmes valeurs, préfixées pour le Studio (Sanity n'expose que SANITY_STUDIO_*)
SANITY_STUDIO_PROJECT_ID=""
SANITY_STUDIO_DATASET="production"

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# URL publique du site — sert au canonical, au sitemap et au robots.txt.
PUBLIC_SITE_URL="http://localhost:4321"

# URL du Studio — utilisée par le Visual Editing pour ouvrir le bon document.
PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# URL du site que le Studio doit prévisualiser (Presentation tool).
SANITY_STUDIO_PREVIEW_URL="http://localhost:4321"

# Environnement de déploiement : development | preview | production
# Toute valeur autre que "production" bloque l'indexation (robots.txt + noindex).
PUBLIC_ENV="development"

# -----------------------------------------------------------------------------
# Jetons Sanity — SECRETS, à ne jamais committer
# Créés sur https://sanity.io/manage > API > Tokens
# -----------------------------------------------------------------------------
# Jeton de lecture (droits « Viewer ») — lit les brouillons pour la preview.
SANITY_READ_TOKEN=""

# Jeton d'écriture (droits « Editor ») — sert UNIQUEMENT à `pnpm seed`.
# À révoquer une fois le contenu injecté.
SANITY_WRITE_TOKEN=""

# Chaîne aléatoire de votre choix — protège l'activation du mode preview.
# Génération : openssl rand -hex 32
SANITY_PREVIEW_SECRET=""

# Secret partagé avec le webhook Sanity qui déclenche le rebuild.
SANITY_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Formulaires — envoi des demandes par email (Brevo, hébergé en UE)
# Clé créée sur https://app.brevo.com > SMTP & API
# -----------------------------------------------------------------------------
BREVO_API_KEY=""

# Destinataire des demandes (inscription, bénévolat, partenariat, contact).
FORM_TO_EMAIL="president.esgabasket@gmail.com"

# Expéditeur — doit être une adresse d'un domaine vérifié dans Brevo.
FORM_FROM_EMAIL="site@esgabasket.fr"

# -----------------------------------------------------------------------------
# Netlify — jeton personnel, pour piloter le site en ligne de commande.
# User settings > Applications > Personal access tokens
# -----------------------------------------------------------------------------
NETLIFY_AUTH_TOKEN=""
